Vagrant.configure("2") do |config|
  config.vm.guest = :windows
  config.vm.communicator = "winrm"
  config.winrm.username = "vagrant"
  config.winrm.password = "vagrant"
  config.vm.provider "libvirt" do |lv, config|
    lv.machine_type = "q35"
    # the UEFI firmware location differs between distros (e.g. Debian/Ubuntu
    # vs Fedora); allow overriding it with the VAGRANT_LIBVIRT_LOADER env var.
    lv.loader = ENV["VAGRANT_LIBVIRT_LOADER"] || [
      "/usr/share/ovmf/OVMF.fd",
      "/usr/share/edk2/ovmf/OVMF.stateless.fd",
    ].find { |path| File.exist?(path) } || "/usr/share/ovmf/OVMF.fd"
    lv.cpu_mode = "host-passthrough"
    lv.features = ["acpi", "apic", "hyperv mode='passthrough'", "vmport state='off'"]
    lv.clock_offset = 'localtime'
    lv.clock_timer :name => 'rtc', :tickpolicy => 'catchup'
    lv.clock_timer :name => 'pit', :tickpolicy => 'delay'
    lv.clock_timer :name => 'hpet', :present => 'no'
    lv.clock_timer :name => 'hypervclock', :present => 'yes'
    lv.input :type => "tablet", :bus => "virtio"
    lv.graphics_type = "spice"
    lv.video_type = "qxl"
    lv.channel :type => "unix", :target_name => "org.qemu.guest_agent.0", :target_type => "virtio"
    lv.channel :type => "spicevmc", :target_name => "com.redhat.spice.0", :target_type => "virtio"
  end
  config.vm.provider "hyperv" do |hv, config|
    hv.vm_integration_services = {
      guest_service_interface: true,
    }
  end
end
